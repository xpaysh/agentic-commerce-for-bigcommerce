# Per-merchant identity
XPAY_MERCHANT_SLUG=acme-outdoors
SITE_URL=https://store.acme.example/
SITE_NAME=Acme Outdoors
SITE_DESCRIPTION=Climbing gear and trail food

# Shared HS256 secret for cart-deeplink JWTs.
# Get this from your xpay merchant account: app.xpay.sh/onboard/bigcommerce
XPAY_API_KEY=xpay_live_REPLACE_ME

# BigCommerce credentials (Settings → API → Store-level API accounts → Create)
# Required scopes for v0.1: Products READ, Carts MODIFY, Orders MODIFY, Information READ
BIGCOMMERCE_STORE_HASH=abc12d3
BIGCOMMERCE_API_TOKEN=REPLACE_WITH_X_AUTH_TOKEN
BIGCOMMERCE_API_BASE=https://api.bigcommerce.com

# Optional
HOST=0.0.0.0
PORT=8787
CHECKOUT_PATH=/checkout
EMIT_OAUTH_PROTECTED_RESOURCE=0
EMIT_AGENT_CARD=0
